{
  "name": "game-capture",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "description": "Lightweight game clipping and recording for Windows",
  "scripts": {
    "postinstall": "npm --prefix ui install",
    "dev": "tauri dev",
    "ui": "npm --prefix ui run dev",
    "build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "fetch-ffmpeg": "pwsh -NoProfile -File scripts/fetch-ffmpeg.ps1",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0"
  }
}
